# Saltbox domain — scripts/saltbox-publish.sh writes Host(`wud.${DOMAIN}`)
# into /opt/traefik/wud.yml (file provider).
DOMAIN=example.com

TZ=Europe/Isle_of_Man
WUD_LOG_LEVEL=info

# Local Docker watcher — https://getwud.app/docs/configuration/watchers/
# Daily at 01:00 (host TZ). Default WUD cron is hourly; daily avoids Docker Hub rate limits.
WUD_WATCHER_LOCAL_CRON=0 1 * * *
WUD_WATCHER_LOCAL_JITTER=60000
WUD_WATCHER_LOCAL_WATCHBYDEFAULT=true
WUD_WATCHER_LOCAL_WATCHALL=false
WUD_WATCHER_LOCAL_WATCHATSTART=true
WUD_WATCHER_LOCAL_WATCHEVENTS=true
# Digest fallback for non-semver tags (linuxserver/hotio :latest). True = notify when the digest moves.
WUD_WATCHER_LOCAL_WATCHDIGESTDEFAULT=true

# Optional SMTP alerts — uncomment to enable.
# https://getwud.app/docs/configuration/triggers/smtp/
# STARTTLS (587/2525): leave TLS_ENABLED=false. Implicit TLS (465): set true.
# WUD_TRIGGER_SMTP_MAIL_HOST=smtp.example.com
# WUD_TRIGGER_SMTP_MAIL_PORT=587
# WUD_TRIGGER_SMTP_MAIL_USER=
# WUD_TRIGGER_SMTP_MAIL_PASS=
# WUD_TRIGGER_SMTP_MAIL_TLS_ENABLED=false
# WUD_TRIGGER_SMTP_MAIL_FROM_NAME=WUD
# WUD_TRIGGER_SMTP_MAIL_FROM_ADDRESS=wud@example.com
# WUD_TRIGGER_SMTP_MAIL_TO=you@example.com
# WUD_TRIGGER_SMTP_MAIL_MODE=batch
# WUD_TRIGGER_SMTP_MAIL_ONCE=true
# WUD_TRIGGER_SMTP_MAIL_THRESHOLD=all
